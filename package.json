{
  "name": "openpanel",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "overrides": {
    "brace-expansion": "5.0.9",
    "dompurify": "3.4.13",
    "fast-uri": "3.1.5",
    "minimatch": "10.2.6",
    "nanoid": "3.3.17"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:module": "node scripts/build-module.mjs",
    "lint": "eslint .",
    "test": "node --test src/detectorAxis.test.js && vitest run --config vitest.config.ts",
    "test:module": "node --test tests-js/module-release.test.mjs",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run build && npm run build:module && npm run test:module && npm run test:e2e",
    "preview": "vite preview"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.562.0",
    "ml-matrix": "^6.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
